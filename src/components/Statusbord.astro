---
// De stand van het lab in één oogopslag. Alle cijfers komen uit src/data/lab.ts.
// Staat op de projectpagina van Verbeek Logistiek, onder de paginatitel.
import { fases, onderdelen, bijgewerkt } from '../data/lab';
import GeheugenBalk from './GeheugenBalk.astro';
import MachineTabel from './MachineTabel.astro';

const huidige = fases.find((f) => f.status === 'bezig');
const datum = new Date(bijgewerkt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<div class="statusbord not-content">
  {huidige && <p class="nu">Nu bezig: fase {huidige.nr} van {fases.length}<strong>{huidige.titel}</strong></p>}

  <ol class="fases">
    {fases.map((f) => (
      <li class={f.status}>
        <b>{f.nr}</b>
        {f.href ? <a href={f.href}>{f.titel}</a> : <span>{f.titel}</span>}
        <small>{f.status === 'klaar' ? 'Klaar' : f.status === 'bezig' ? 'Bezig' : 'Gepland'}</small>
      </li>
    ))}
  </ol>

  <section>
    <h2>Geheugenplan voor de host</h2>
    <GeheugenBalk />
  </section>

  <section>
    <h2>Machines</h2>
    <MachineTabel />
  </section>

  <nav aria-label="Onderdelen van het project">
    {onderdelen.map((o) => o.href
      ? <a href={o.href}>{o.titel}</a>
      : <span>{o.titel}<small>volgt</small></span>)}
  </nav>

  <p class="bijgewerkt">Met de hand bijgehouden, voor het laatst op <time datetime={bijgewerkt}>{datum}</time>.</p>
</div>

<style>
  .statusbord { color: var(--bord-inkt); padding-block: 1rem 2rem; }
  .nu { margin: 0; color: var(--bord-zacht); font-stretch: 80%; font-size: 1.05rem; }
  .nu strong { display: block; font-stretch: 100%; font-size: 1.9rem; line-height: 1.1; color: var(--bord-inkt); font-weight: 600; }

  .fases { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .fases li { margin: 0; padding: 0.6rem 0.7rem 0.7rem; background: var(--bord-vlak); border-top: 4px solid var(--bord-lijn); display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .fases b { font-stretch: 125%; font-size: 1.4rem; line-height: 1; color: var(--bord-zacht); }
  .fases :is(span, a) { font-stretch: 78%; font-size: 0.98rem; color: var(--bord-zacht); overflow-wrap: anywhere; hyphens: auto; }
  .fases small { font-stretch: 78%; font-size: 0.8rem; color: var(--bord-zacht); }
  .fases .bezig { border-top-color: var(--vlan-20); background: var(--bord-hoog); }
  .fases .klaar { border-top-color: var(--vlan-30); }
  .fases :is(.bezig, .klaar) :is(b, span, a) { color: var(--bord-inkt); }

  section { margin-top: 2.75rem; }
  h2 { margin: 0 0 0.8rem; font-size: 1.15rem; font-weight: 600; font-stretch: 110%; color: var(--bord-inkt); }

  nav { margin-top: 2.75rem; display: flex; flex-wrap: wrap; gap: 4px; }
  nav :is(a, span) { flex: 1 1 11rem; padding: 0.9rem 1rem; background: var(--bord-vlak); font-weight: 600; font-stretch: 105%; }
  nav a { color: var(--bord-inkt); background: var(--bord-hoog); border-left: 4px solid var(--vlan-20); text-decoration: none; }
  nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  nav span { color: var(--bord-zacht); }
  nav small { font-weight: 400; margin-left: 0.5rem; font-stretch: 80%; }
  .bijgewerkt { margin: 1.5rem 0 0; color: var(--bord-zacht); font-size: 0.9rem; }

  @media (max-width: 50rem) {
    .fases { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 30rem) {
    .fases { grid-template-columns: repeat(3, 1fr); }
  }
</style>
